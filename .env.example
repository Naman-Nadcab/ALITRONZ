# Public site origin, no trailing slash. Defaults to https://alitronz.com
# when unset. Set this only to override that origin.
NEXT_PUBLIC_SITE_URL=https://alitronz.com

# Optional published contact details. Leave blank until verified.
# Never put a guessed address, phone number, or registration number here.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_REGISTRATION=
NEXT_PUBLIC_JURISDICTION=

# Enquiry delivery. Configure ONE channel. If neither channel is complete,
# the form reports that the enquiry was not sent.
#
# Priority: Resend is used when RESEND_API_KEY, ENQUIRY_TO_EMAIL, and
# ENQUIRY_FROM_EMAIL are all set. Otherwise ENQUIRY_WEBHOOK_URL is used.
# Server-only. Never expose these in client code.

# Resend (https://resend.com). FROM must be an address on a domain you verify
# with Resend. TO is the internal inbox that should receive enquiries.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=
ENQUIRY_TO_EMAIL=

# Generic webhook. The site POSTs the enquiry JSON to this URL.
# Optional bearer token sent as Authorization: Bearer <secret>.
# http and https URLs are accepted so a local receiver can be used in development.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=
